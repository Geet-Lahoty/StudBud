# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon/public key (Settings → API → anon key)
VITE_SUPABASE_ANON_KEY=

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=

# Set to "true" to use hardcoded sample data instead of the real Gemini API.
VITE_USE_MOCK=

# Set to "true" to show a "Skip quiz (demo)" button on the quiz screen.
VITE_DEMO_MODE=
