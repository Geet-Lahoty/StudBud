# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon/public key (Settings → API → anon key)
VITE_SUPABASE_ANON_KEY=

# Note: The Gemini API key is stored securely in Supabase secrets (not in the frontend):
# supabase secrets set GEMINI_API_KEY="your-gemini-key"

# Set to "true" to use hardcoded sample data instead of the real AI API.
VITE_USE_MOCK=false

# Set to "true" to show a "Skip quiz (demo)" button on the quiz screen.
VITE_DEMO_MODE=false
